# Perfetto trace 配置模板（全面数据源）。
# 由 trace_capture.py 的 _render_config 参数化填充。
# 用法：adb shell perfetto -c <此文件> --txt -o <out> --background
#
# 设计原则（参考 https://perfetto.dev/docs/reference/trace-config-proto）：
#   - 三 buffer 防覆盖：[0] ftrace(sched 海量) / [1] process_stats+packages+log / [2] FrameTimeline
#   - 数据源尽量全面：sched + 内存回收 + atrace(含 camera/video) + 帧时间线 + 进程 + 日志
#   - Android 12+ user 版可用（配置放 /data/misc/perfetto-configs/）

duration_ms: {{DURATION_MS}}

# buffer 0: ftrace（sched_switch 海量事件，RING 覆盖旧数据）
buffers {
  size_kb: {{BUFFER_KB}}
}
# buffer 1: process_stats / packages_list / log（中等数据量）
buffers {
  size_kb: 32768
}
# buffer 2: FrameTimeline（小数据，独立空间不被挤掉）
buffers {
  size_kb: 32768
}

# ── ftrace：内核事件 + 全 atrace 类别（含 camera/video）→ buffer 0 ──
data_sources {
  config {
    name: "linux.ftrace"
    target_buffer: 0
    ftrace_config {
      buffer_size_kb: 32768
      drain_period_ms: 1000
      # 内核调度与频率
      ftrace_events: "sched/sched_switch"
      ftrace_events: "sched/sched_waking"
      ftrace_events: "sched/sched_wakeup_new"
      ftrace_events: "sched/sched_blocked_reason"
      ftrace_events: "power/cpu_frequency"
      ftrace_events: "power/suspend_resume"
      # 内存回收压力（direct reclaim / compaction / OOM）
      ftrace_events: "vmscan/mm_vmscan_direct_reclaim_begin"
      ftrace_events: "vmscan/mm_vmscan_direct_reclaim_end"
      ftrace_events: "vmscan/mm_vmscan_kswapd_sleep"
      ftrace_events: "vmscan/mm_vmscan_kswapd_wake"
      ftrace_events: "compaction/mm_compaction_begin"
      ftrace_events: "compaction/mm_compaction_end"
      # binder（IPC 延迟诊断）
      ftrace_events: "binder/binder_transaction"
      # atrace 全类别（gfx/view/am/wm 应用层 + camera/video 硬件层）
      atrace_categories: "sched"
      atrace_categories: "gfx"
      atrace_categories: "view"
      atrace_categories: "am"
      atrace_categories: "wm"
      atrace_categories: "ss"
      atrace_categories: "input"
      atrace_categories: "audio"
      atrace_categories: "video"
      atrace_categories: "camera"
      atrace_categories: "res"
      atrace_categories: "dalvik"
      atrace_categories: "bionic"
      {{ATRACE_SCHED}}
      atrace_apps: "{{APP_PKG}}"
    }
  }
}

# ── 进程统计（周期采样 /proc/pid/status）→ buffer 1 ──
data_sources {
  config {
    name: "linux.process_stats"
    target_buffer: 1
    process_stats_config {
      scan_all_processes_on_start: true
      record_thread_names: true
      proc_stats_poll_ms: 5000
    }
  }
}

# ── 系统统计（/proc/meminfo + /proc/vmstat 周期采样，250ms）→ buffer 1 ──
# meminfo 提供 MemAvailable/MemFree 等系统内存水位；vmstat 提供 pgmajfault/pswpin/pswpout 等回收压力。
# 注意：这些字段在 sys_stats_config（数据源 linux.sys_stats）里，不在 process_stats_config 中。
# meminfo_counters 留空 = 上报所有已知 counter（含 MemAvailable）。
data_sources {
  config {
    name: "linux.sys_stats"
    target_buffer: 1
    sys_stats_config {
      meminfo_period_ms: 250
      vmstat_period_ms: 250
    }
  }
}

# ── 包列表（进程↔包名映射）→ buffer 1 ──
data_sources {
  config {
    name: "android.packages_list"
    target_buffer: 1
  }
}

# ── 系统日志（logcat，lmkd/OOM/相机错误）→ buffer 1 ──
# 不指定 log_ids/min_prio（用默认，避免不同 perfetto 版本的 enum 兼容问题）
data_sources {
  config {
    name: "android.log"
    target_buffer: 1
  }
}

# ── FrameTimeline（jank + 相机 first buffer，Android 12+）→ buffer 2 ──
{{FRAMETIMELINE_BLOCK}}
